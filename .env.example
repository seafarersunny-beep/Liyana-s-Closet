# Frontend (public values only; safe to ship in the browser bundle)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Optional: enables background push. Public half of the VAPID pair.
VITE_VAPID_PUBLIC_KEY=
# Optional: set when hosting under a sub-path, e.g. /liyanas-closet/
# VITE_BASE=/
